# Optional: send the contact form through EmailJS (https://dashboard.emailjs.com).
# Copy to .env and fill in. Without these, the form opens the visitor's email app instead.
# Template variables available: {{name}} {{email}} {{project_type}} {{message}} (also {{from_name}}, {{reply_to}}).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
